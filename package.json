{
  "name": "deepcleaner-ag",
  "version": "1.0.6",
  "version": "1.0.7",
  "description": "High-accuracy, multi-layer defensive security, SAST, secret detection, dependency, and malware-indicator scanner",
  "type": "module",
  "bin": {
    "deepcleaner": "bin/deepcleaner.js"
  },
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node bin/deepcleaner.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "files": [
    "bin",
    "dist",
    "rules",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "security",
    "scanner",
    "sast",
    "secret-detection",
    "malware-detection",
    "vulnerabilities",
    "osv",
    "ast",
    "taint-analysis",
    "appsec",
    "cli",
    "code-security",
    "docker-security",
    "ci-cd-security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhiGandhi-A/deepcleaner-npm.git"
  },
  "bugs": {
    "url": "https://github.com/AbhiGandhi-A/deepcleaner-npm/issues"
  },
  "homepage": "https://github.com/AbhiGandhi-A/deepcleaner-npm#readme",
  "author": "Abhishek Gandhi <abhigandhi@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "commander": "^13.1.0",
    "mongodb": "^6.13.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
